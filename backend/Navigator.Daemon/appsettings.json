{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=navigator;Username=navigator;Password=password"
  },
  "JobConfigs": {
    "DatabaseSizeEstimationJob": {
      "CronExpression": "0 0/5 * * * ?"
    },
    "GatheringRisIdsJob": {
      "CronExpression": "0 0/5 * * * ?"
    },
    "GatheringJourneysJob": {
      "CronExpression": "0/10 * * * * ?"
    },
    "RisIdSnapshotJob": {
      "CronExpression": "0 0/5 * * * ?"
    },
    "JourneySnapshotJob": {
      "CronExpression": "0 0/5 * * * ?"
    },
    "StaleRisIdDeactivationJob": {
      "CronExpression": "0 0/15 * * * ?"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki:3100",
          "propertiesAsLabels": [ "app", "env" ]
        }
      }
    ]
  }
}
