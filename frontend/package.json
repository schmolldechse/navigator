{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"api": "bun x openapi-typescript-codegen --input http://localhost:8080/swagger.json --output ./src/lib/api --client fetch"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.48.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/d3-scale": "^4.0.9",
		"@types/leaflet": "^1.9.21",
		"@types/luxon": "^3.7.1",
		"@types/node": "^24.10.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.43.5",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.2"
	},
	"dependencies": {
		"@fontsource/roboto-mono": "^5.2.8",
		"@lucide/svelte": "^0.546.0",
		"d3-array": "^3.2.4",
		"d3-scale": "^4.0.2",
		"layerchart": "^2.0.0-next.42",
		"leaflet": "^1.9.4",
		"luxon": "^3.7.2",
		"valibot": "^1.1.0"
	}
}
